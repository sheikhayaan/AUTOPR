# Keep the Docker build context small and reproducible.
# Neither image (app or sandbox) needs these; sending .venv especially makes
# the build crawl.
.venv/
.git/
.pytest_cache/
__pycache__/
*.pyc
*.db
.env
.mypy_cache/
.ruff_cache/
docs/
tests/
# The frontend is a separate artifact (built/served on its own); the app image
# never needs it, and frontend/node_modules would bloat the context enormously.
frontend/
# Local run logs / scratch (e.g. api.local, web.local) and CI config.
*.local
.github/
