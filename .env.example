# --- AutoPR configuration -------------------------------------------------
# Copy to `.env` and fill in. Never commit the real .env.
#
# Every knob the app reads is listed here, grouped the way `app/config.py` groups
# it. Anything you leave out falls back to the default noted in the comment.
# Names are the field names upper-cased with an `AUTOPR_` prefix.

# --- Secrets ---
# GitHub webhook shared secret. Used to verify the X-Hub-Signature-256 HMAC.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# The app REFUSES TO START if this is left at the placeholder below (unless
# AUTOPR_ALLOW_INSECURE=1). Replace it with a real value.
AUTOPR_WEBHOOK_SECRET=changeme-generate-a-real-secret

# Bearer token for the mutating + ops API (POST /reviews/{id}/approve|reject).
# Send it as `Authorization: Bearer <token>`. Compared in constant time.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# The app REFUSES TO START if this is empty (unless AUTOPR_ALLOW_INSECURE=1):
# an unauthenticated /approve means any caller who can reach the API decides
# what this bot writes to your repository.
AUTOPR_API_TOKEN=

# --- Multi-tenant GitHub (only needed for outward writes) ---
# Fine-grained PAT with `pull_requests: write` + `contents: read` on the repos
# you point the webhook at. AutoPR makes NO write calls without it.
AUTOPR_GITHUB_TOKEN=

# true => every GitHub write is a logged no-op (the default). Flip to false only
# when you mean it. Requires a token above; without one, the client stays a no-op.
AUTOPR_GITHUB_DRY_RUN=true

# Hand-off mode: AutoPR holds no write credential at all. Reviews are still
# produced and queued, but every action degrades to "open the PR in your browser
# and do it yourself". This is the single-operator posture the project is scoped
# to; when true, no review is ever auto-posted, regardless of risk.
AUTOPR_HANDOFF_MODE=false

# Highest risk score that is auto-posted as a plain comment when NOT in hand-off
# mode. `medium` and above are always held for a human. Code-changing actions
# (propose_fix) are human-gated no matter what this says.
AUTOPR_AUTO_COMMENT_MAX_RISK=low

# GitHub API base URL. Only override for GitHub Enterprise.
AUTOPR_GITHUB_API_URL=https://api.github.com

# --- API auth / perimeter -------------------------------------------------
# Also require the bearer token on the READ endpoints (/stats, /jobs, /reviews*).
# Default false so the read-only dashboard demos without a token. Set it to true
# on any instance reachable from the internet: those endpoints expose repo names,
# PR numbers, authors and the exact comment bodies awaiting your approval.
AUTOPR_REQUIRE_AUTH_FOR_READS=false

# Comma-separated repo allowlist ("owner/name,owner/other"). Empty = accept any
# repo that can deliver a signed webhook. Set it when the bot is installed on a
# repo strangers can open PRs on: a fork PR there is a *genuine* signed delivery,
# so without this anyone can spend your LLM budget by opening a pull request.
AUTOPR_ALLOWED_REPOS=

# CORS allowlist (comma-separated origins). A literal "*" allows any origin.
# The default covers the local Vite dev/preview servers.
AUTOPR_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000,http://127.0.0.1:5173

# Escape hatch: permit the placeholder webhook secret above. Intended for
# local/dev/tests ONLY — must be false (unset) in production.
AUTOPR_ALLOW_INSECURE=false

# Rate limiting (in-process, per client IP, fixed 60s window).
AUTOPR_RATE_LIMIT_ENABLED=true
AUTOPR_RATE_LIMIT_WEBHOOK_PER_MIN=120
AUTOPR_RATE_LIMIT_MUTATIONS_PER_MIN=30

# Largest webhook body we will buffer (bytes, default 10 MB). Enforced while
# streaming and before the HMAC check, so an unauthenticated caller cannot make
# us allocate arbitrary memory. GitHub caps deliveries at 25 MB.
AUTOPR_MAX_WEBHOOK_BYTES=10000000

# --- Datastores -----------------------------------------------------------
# Postgres. In Docker Compose this host is the service name `postgres`.
# For local (non-Docker) runs the tests use SQLite automatically, so you
# don't strictly need this until Docker is up.
AUTOPR_DATABASE_URL=postgresql+psycopg://autopr:autopr@postgres:5432/autopr

# Redis (Streams). In Docker Compose this host is the service name `redis`.
AUTOPR_REDIS_URL=redis://redis:6379/0
# Bounded socket timeouts: a stalled Redis must not hang the request loop.
AUTOPR_REDIS_SOCKET_TIMEOUT_S=10
AUTOPR_REDIS_CONNECT_TIMEOUT_S=5
AUTOPR_REDIS_HEALTH_CHECK_INTERVAL_S=30

# Redis Streams names.
AUTOPR_STREAM_NAME=autopr:jobs
AUTOPR_CONSUMER_GROUP=autopr-workers

# Qdrant (RAG store). Declared for the Compose stack; the graph is built with
# `rag=None` today, so nothing reads it yet.
AUTOPR_QDRANT_URL=http://qdrant:6333

# --- Worker behaviour -----------------------------------------------------
# Hard cap on executions of one job. Delivery N+1 escalates to DEAD (the human
# queue) without running it again.
AUTOPR_MAX_ATTEMPTS=5
# A stream entry idle this long (ms) is assumed abandoned and reclaimed via
# XAUTOCLAIM. MUST exceed the slowest job or a second worker will re-run a
# healthy job: worst case is ~8 min (LLM calls + a 120s sandbox run), so 15 min.
AUTOPR_RECLAIM_IDLE_MS=900000
# How often to re-publish jobs stranded between the DB commit and the XADD.
AUTOPR_RECONCILE_INTERVAL_S=60

# --- LLM ---
# Groq API key. Without it the agents fall back to their deterministic stubs.
AUTOPR_GROQ_API_KEY=
# Override the model id (empty => the agents' own default).
AUTOPR_LLM_MODEL=
# Per-call timeout, seconds.
AUTOPR_LLM_TIMEOUT_S=30

# --- Sandbox (fix verification) -------------------------------------------
# Image that already contains the target repo's dependencies; it runs with
# --network none, so nothing can be installed at verification time.
AUTOPR_SANDBOX_IMAGE=autopr-sandbox:latest
# Path to the docker CLI (empty => resolve `docker` from PATH).
AUTOPR_DOCKER_BIN=
# Host-side wall clock. The container is killed when this elapses.
AUTOPR_SANDBOX_TIMEOUT_S=120
AUTOPR_SANDBOX_MEMORY=512m
AUTOPR_SANDBOX_CPUS=1.0
AUTOPR_SANDBOX_PIDS_LIMIT=256
# verify -> re-prompt loop budget for the fix agent.
AUTOPR_MAX_FIX_ATTEMPTS=2

# --- Repo snapshot caps ---------------------------------------------------
# Per-file and per-count caps multiply (2000 x 1 MB = 2 GB), so the total cap is
# the one that actually bounds worker memory. Keep it well under the container's
# memory limit.
AUTOPR_SNAPSHOT_MAX_FILE_BYTES=1000000
AUTOPR_SNAPSHOT_MAX_FILES=2000
AUTOPR_SNAPSHOT_MAX_TOTAL_BYTES=25000000
# Ceiling on the compressed tarball download, enforced while streaming.
AUTOPR_SNAPSHOT_MAX_TARBALL_BYTES=100000000

# --- Observability --------------------------------------------------------
# JSON logs (one event per line). Set false locally for colourised console output.
AUTOPR_LOG_JSON=true
# Prometheus /metrics endpoint.
AUTOPR_METRICS_ENABLED=true
